# ─── Microsoft Entra ID (Azure AD) ───────────────────────────────────────────
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-addin-client-id
AZURE_CLIENT_SECRET=your-client-secret

# ─── Office Add-in URLs ───────────────────────────────────────────────────────
# URL where the add-in static files are hosted (used in manifest.xml too)
ADDIN_URL=https://m365-leave-visibility.azurewebsites.net
# URL of the backend API
API_BASE_URL=https://m365-leave-visibility-api.azurewebsites.net

# ─── iTrent API ───────────────────────────────────────────────────────────────
# Leave BLANK for local DEV_MODE testing — mock data is served instead.
# Fill these in only when connecting to a real iTrent instance (production).
ITRENT_BASE_URL=
ITRENT_API_PATH=/api/odata/v1
# Authentication method: "basic" | "apikey" | "oauth2"
ITRENT_AUTH_METHOD=basic
ITRENT_USERNAME=
ITRENT_PASSWORD=
ITRENT_API_KEY=
# OAuth2 (if ITRENT_AUTH_METHOD=oauth2)
ITRENT_CLIENT_ID=
ITRENT_CLIENT_SECRET=
ITRENT_TOKEN_URL=

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# DEV_MODE=true lets the server boot without real Azure/iTrent credentials,
# serves mock leave data, and bypasses SSO for local testing. NEVER set in prod.
DEV_MODE=true
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=https://localhost:3000,https://m365-leave-visibility.azurewebsites.net

# ─── Azure Cosmos DB (production leave data store) ───────────────────────────
COSMOS_DB_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_DB_KEY=your-primary-key
COSMOS_DB_DATABASE=leave-visibility
COSMOS_DB_CONTAINER=leave-records

# ─── Sync ─────────────────────────────────────────────────────────────────────
# Cron expression for scheduled sync (default: every 30 mins)
SYNC_CRON=*/30 * * * *
# "memory" for dev; "cosmos" for production
CACHE_BACKEND=memory

# ─── IT Support Portal ────────────────────────────────────────────────────────
# A public intake form for practice staff to log IT issues. See
# docs/SUPPORT_PORTAL.md for the full guide.
SUPPORT_PORTAL_ENABLED=true
# Serve the static portal frontend from this API (set false to host it separately).
SERVE_PORTAL=true
# Override the static portal path (defaults to <repo>/support-portal).
PORTAL_DIR=
# Public origin the portal is served from (added to the CORS allowlist).
PORTAL_BASE_URL=

# Mailbox urgent + standard tickets are routed to.
SUPPORT_EMAIL=it.support@hakimgroup.co.uk
# Friendly name for the non-urgent queue.
SUPPORT_STANDARD_QUEUE=standard-support-queue
# Email the requester a confirmation when they supply an address.
SEND_CONFIRMATION_EMAIL=true

# Spam protection / CAPTCHA.
#   builtin   — server-issued maths challenge (default, no third party, works offline)
#   turnstile — Cloudflare Turnstile     (set CAPTCHA_SITE_KEY + CAPTCHA_SECRET_KEY)
#   recaptcha — Google reCAPTCHA v2/v3   (set CAPTCHA_SITE_KEY + CAPTCHA_SECRET_KEY)
#   hcaptcha  — hCaptcha                 (set CAPTCHA_SITE_KEY + CAPTCHA_SECRET_KEY)
CAPTCHA_PROVIDER=builtin
# REQUIRED in production: a long random string used to sign builtin challenges.
CAPTCHA_SECRET=change-me-to-a-long-random-string
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
# Builtin challenge lifetime + minimum human fill time.
CAPTCHA_TTL_MS=300000
CAPTCHA_MIN_FILL_SECONDS=2

# Microsoft Teams alerting for URGENT tickets. Paste the URL from a Power
# Automate "When a Teams webhook request is received" flow (or a connector
# webhook). Leave blank to disable (alerts are then just logged).
TEAMS_WEBHOOK_URL=

# SMTP transport for transactional email. Leave SMTP_HOST blank to log emails
# instead of sending them (handy in dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Hakim Group IT Support <it.support@hakimgroup.co.uk>

# Ticket storage: "file" (append-only JSONL, default) | "cosmos" | "memory".
TICKET_STORE_BACKEND=file
# Override the JSONL path (defaults to server/data/tickets.jsonl).
TICKET_STORE_FILE=
# Cosmos container name when TICKET_STORE_BACKEND=cosmos (re-uses COSMOS_DB_*).
COSMOS_DB_TICKETS_CONTAINER=support-tickets

# Optional API key guarding GET /api/tickets (admin list). Blank = endpoint off.
ADMIN_API_KEY=
